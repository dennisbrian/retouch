# Model binaries stay untracked; the manifest is source-of-truth and IS tracked.
# Anchored so scripts/models/ (export tooling) is not swallowed.
/models/*
!/models/manifest.json
*.task
test_output/
benchmark_results.json
__pycache__/
*.pyc
.coverage
htmlcov/
.DS_Store
*.egg-info/
dist/
build/
*.spec
.pytest_cache/
.venv-face-aware/
.quadcodeai/
cc.json
