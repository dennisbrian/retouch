{
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m py_compile *)",
      "Bash(scripts/retouch-preview *)",
      "Skill(code-review)",
      "Skill(simplify)",
      "Skill(verify)",
      "Skill(run)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) python3 -m py_compile \"$f\"; (command -v ruff >/dev/null 2>&1 && ruff check --fix \"$f\") || true;; esac; } || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/uncommitted-changes-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-pytest-bg.sh",
            "asyncRewake": true,
            "timeout": 900
          }
        ]
      }
    ]
  }
}
