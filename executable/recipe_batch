#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MPLCONFIGDIR="${MPLCONFIGDIR:-/private/tmp/retouch-mpl}"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-/private/tmp/retouch-pycache}"

cd "${ROOT_DIR}"
exec "${PYTHON_BIN:-python3}" scripts/batch/recipe_batch.py "$@"
